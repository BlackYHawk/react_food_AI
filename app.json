{
  "expo": {
    "name": "react_food_AI",
    "slug": "food_ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "scheme": "foodai",
    "jsEngine": "hermes",
    "android": {
      "package": "com.leqinde.react_food_ai",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/home_cuts.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.leqinde.react-food-ai"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(name) to access your camera",
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(name) to access your camera",
          "microphonePermission": "Allow $(name) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/login_robot.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b403048d-98bc-423c-8306-8e2c0bda389a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/b403048d-98bc-423c-8306-8e2c0bda389a"
    }
  }
}
